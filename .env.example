# Database (Supabase PostgreSQL)
# Get this from: https://app.supabase.com/project/_/settings/database
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL="postgresql://postgres:password@localhost:5432/frictionless_dev"

# Application
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# NextAuth.js (for developer authentication)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-minimum-32-chars-change-in-prod"

# Security (for credential encryption and webhook signing)
AUTH_SECRET="your-auth-secret-here-change-in-production"
WEBHOOK_SIGNING_SECRET="your-webhook-secret-here"

# NextAuth.js OAuth Providers (for developer login to the platform)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

MICROSOFT_CLIENT_ID="your-microsoft-client-id"
MICROSOFT_CLIENT_SECRET="your-microsoft-client-secret"

# SmartHooks Integration (Vantrakticks Mono Repo)
SMARTHOOKS_WEBHOOK_URL="https://smarthooks.vantrakticks.com/api/event"
SMARTHOOKS_API_KEY="your-smarthooks-api-key"

# Stripe (User will configure via dashboard)
# STRIPE_SECRET_KEY=""
# STRIPE_PUBLISHABLE_KEY=""
# STRIPE_WEBHOOK_SECRET=""

# SendGrid (User will configure via dashboard)
# SENDGRID_API_KEY=""
# SENDGRID_FROM_EMAIL=""

# OAuth Providers (Optional - User configurable)
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""
